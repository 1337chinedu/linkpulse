PORT=4000
NODE_ENV=development

# Local Docker Postgres (docker compose up -d):
DATABASE_URL=postgresql://linkpulse:linkpulse@localhost:5433/linkpulse
PGSSL=false

# Neon (production): copy the connection string from your Neon project
# dashboard and remove the PGSSL=false line above (Neon requires SSL).
# DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Secret used to sign JWTs. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-random-64-char-hex-string

# Comma-separated list of origins allowed to call /api/* from browser JS.
# Defaults to http://localhost:5173 (the Vite dev server) if unset. In
# production, set this to your deployed frontend's origin(s) instead.
CORS_ORIGINS=http://localhost:5173

# Sentry DSN for error tracking. Get one free at sentry.io. Leave unset to
# disable Sentry entirely (it becomes an inert no-op client).
SENTRY_DSN=
