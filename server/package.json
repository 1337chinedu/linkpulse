{
  "name": "linkpulse-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LinkPulse API server",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon --import ./src/instrument.js src/index.js",
    "start": "node --import ./src/instrument.js src/index.js",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "test:migrate": "node-pg-migrate up --envPath .env.test",
    "test": "npm run test:migrate && node --import ./scripts/test-env-setup.js --test --test-concurrency=1"
  },
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "@upstash/redis": "^1.38.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "pino-pretty": "^11.2.1"
  }
}
